# 环境变量配置模板
# 复制此文件为 .env 并填入您的配置

# ===========================================
# 部署者私钥配置 (二选一)
# ===========================================

# 方式1: 使用加密私钥 (推荐)
# 运行 yarn account:import 导入您的私钥
# 或运行 yarn account:generate 生成新账户
DEPLOYER_PRIVATE_KEY_ENCRYPTED=""

# 方式2: 使用明文私钥 (不推荐，仅用于测试)
# 注意: 不要将明文私钥提交到版本控制系统
__RUNTIME_DEPLOYER_PRIVATE_KEY=""

# ===========================================
# RPC 配置
# ===========================================

# Alchemy API Key (用于访问各种测试网)
