# ===========================================
# 部署配置
# ===========================================

# 是否启用主网分叉 (用于本地测试)
MAINNET_FORKING_ENABLED=false

# Gas 价格配置 (可选)
# 如果网络拥堵，可以设置更高的 gas 价格
# GAS_PRICE="20000000000"  # 20 gwei

# ===========================================
# 使用说明
# ===========================================

# 1. 复制此文件为 .env
# 2. 获取 Alchemy API Key 并填入 ALCHEMY_API_KEY
# 3. 获取 Etherscan API Key 并填入 ETHERSCAN_V2_API_KEY
# 4. 选择一种方式配置私钥:
#    - 推荐: 运行 yarn account:import 导入私钥
#    - 或者: 直接填入 __RUNTIME_DEPLOYER_PRIVATE_KEY
# 5. 确保测试网账户有足够的测试代币
# 6. 运行部署命令: yarn deploy:testnet <network>

